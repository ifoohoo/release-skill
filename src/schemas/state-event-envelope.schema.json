{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/state-event-envelope.json",
  "title": "StateEventEnvelope",
  "description": "业务中立的仅追加（append-only）状态事件信封：事件序号、摘要链与写入者隔离令牌由机制层维护，事件类型、生产者标识与载荷业务含义归消费方所有。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "eventId",
    "eventType",
    "payloadSchemaVersion",
    "producer",
    "idempotencyKey",
    "writerOwner",
    "writerFencing",
    "sequence",
    "prevDigest",
    "payload",
    "recordDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.state-event-envelope"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "payloadSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[!-~]{1,256}$"
    },
    "writerOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "writerFencing": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "prevDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {},
    "recordDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
