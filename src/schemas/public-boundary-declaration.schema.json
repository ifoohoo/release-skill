{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/public-boundary-declaration.json",
  "title": "PublicBoundaryDeclaration",
  "description": "公开发布边界声明契约（审计 SG-17）：界定项目公开发布文件集与内部工作集的边界，包括公开根目录（publicRoots）、显式公开文件清单（publicFiles）、必含路径（requiredPaths）与禁入路径（forbiddenPaths）；对实际文件集的机械核验由 engineering-kit 的公开边界检查执行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "declarationId",
    "declaredVersion",
    "publicRoots",
    "requiredPaths",
    "forbiddenPaths",
    "publicFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.public-boundary-declaration"
    },
    "declarationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "本边界声明的稳定 kebab-case 标识符。"
    },
    "declaredVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "本边界声明适用的发布版本号。"
    },
    "publicRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
      },
      "description": "项目根目录相对 POSIX 目录根列表；仅位于这些目录下的文件可归入公开发布集。"
    },
    "requiredPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
      },
      "description": "发布集中必须存在的路径列表；缺失任一路径即构成边界违规。"
    },
    "forbiddenPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
      },
      "description": "严禁进入公开发布集的路径列表；出现任一路径即构成边界违规。"
    },
    "publicFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
      },
      "description": "显式列举的全部公开文件；位于公开根目录下但未列入此清单的文件均判为未声明泄露。"
    },
    "note": {
      "type": "string",
      "description": "可选的人类可读说明备注，不参与机械消费。"
    }
  }
}
