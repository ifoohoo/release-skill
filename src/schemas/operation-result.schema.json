{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/operation-result.json",
  "title": "OperationResult",
  "description": "内核协议操作的终态结果信封：携带终态、可选输出载荷与稳定错误码列表；结果文档绝不携带非终态。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocol",
    "operationId",
    "operation",
    "state",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.operation-result"
    },
    "protocol": {
      "$ref": "#/$defs/protocolRef"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "原样回显请求中的 operationId。"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "原样回显请求中的 operation 名称。"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "rejected"
      ],
      "description": "操作终态，取值集合与内核协议的 terminalStates 完全一致。"
    },
    "outputs": {
      "type": [
        "object",
        "null"
      ],
      "description": "操作输出对象；当 state 为 succeeded 时承载有效结果。"
    },
    "errors": {
      "type": "array",
      "description": "当 state 为 succeeded 时为空数组；处于其他终态时至少包含一条带稳定错误码的错误记录。",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "可选的操作到达终态 RFC 3339 时间戳。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "rejected"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "protocolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)*$",
          "description": "已注册的协议名称（点分 kebab-case 段）。"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "已注册的协议整数版本号。"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^SFC[0-9]{4}$",
          "description": "来自冻结 Contracts 错误注册表的稳定错误码。"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "description": "可选的指向出错文档位置的 JSON Pointer。"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
