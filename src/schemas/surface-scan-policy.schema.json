{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/surface-scan-policy.json",
  "title": "SurfaceScanPolicy",
  "description": "通用策略驱动表面扫描器（scanSurface）的声明式策略契约：由消费方提供禁入路径正则（pathPatterns）、禁入内容正则（contentPatterns）及预期用途说明；任一模式命中或正则编译失败均按封闭失败拒绝。Foundation 不解释私有身份或豁免语义，与工作区私有 leak-policy.json 的字节结构彼此独立。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "pathPatterns",
    "contentPatterns",
    "allowedUses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.surface-scan-policy"
    },
    "pathPatterns": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "contentPatterns": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "allowedUses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "pathPatterns": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "contentPatterns": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ]
}
