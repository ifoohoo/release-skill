{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/token-estimate-record.json",
  "title": "TokenEstimateRecord",
  "description": "确定性 Token 估算权威记录（审计整改 C1 / SFA-CONTEXT-028）：在 cjk-char-whitespace-split 算法下测量文本，每个中日韩统一表意文字码位计 1 个 token，每段连续非空白非 CJK 码位计 1 个 token，空白符作分隔。记录携带估算器身份、版本与精确分段计数（tokens === segmentation.cjkCharacters + segmentation.otherRuns），无模型调用、无外部依赖、无网络请求且不含时间戳。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "estimator",
    "algorithm",
    "unit",
    "input",
    "segmentation",
    "tokens",
    "precision",
    "scope",
    "guarantees"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.token-estimate-record"
    },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "skill-family.token-estimator"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "algorithm": {
      "const": "cjk-char-whitespace-split"
    },
    "unit": {
      "const": "tokens"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codePoints",
        "inputBytes"
      ],
      "properties": {
        "codePoints": {
          "type": "integer",
          "minimum": 0
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cjkCharacters",
        "whitespaceSeparators",
        "otherRuns"
      ],
      "properties": {
        "cjkCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "whitespaceSeparators": {
          "type": "integer",
          "minimum": 0
        },
        "otherRuns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "precision": {
      "const": "deterministic-heuristic"
    },
    "scope": {
      "const": "content-text-only"
    },
    "guarantees": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "covers-content-text-only",
          "no-model-calls",
          "no-tokenizer-dependency",
          "no-network-access",
          "deterministic-segmentation"
        ]
      }
    }
  }
}
