{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/fixed-set-generation-pointer.json",
  "title": "Fixed-set generation pointer",
  "description": "固定文件集世代存储的唯一提交指针：仅记录当前生效的单个世代目录段名与闭包摘要，不存储本机绝对根路径。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generation",
    "closureDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.fixed-set-generation-pointer"
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "not": {
        "const": "current"
      }
    },
    "closureDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
