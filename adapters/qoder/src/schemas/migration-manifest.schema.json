{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/migration-manifest.json",
  "title": "MigrationManifest",
  "description": "存量项目接入迁移清单：声明必须退出的旧基础设施条目（逐项绑定替代机制）及临时豁免。每条临时豁免必须完整携带 owner、reason、deadline、migrationTarget 四个必填字段。超出路径形态的目录包含边界由 Harness 保障，所有路径仅在目标项目根目录内读取。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.migration-manifest"
    },
    "capabilityUseContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "locale"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "contracts",
            "harness",
            "engineering-kit",
            "profile",
            "all"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN"
          ]
        }
      }
    },
    "capabilityUses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "useId",
          "problemStatement",
          "constraints",
          "retainedGuarantees"
        ],
        "properties": {
          "useId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "problemStatement": {
            "allOf": [
              {
                "$ref": "#/$defs/trimmedCapabilityUseText"
              },
              {
                "type": "string",
                "maxLength": 1000
              }
            ]
          },
          "constraints": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/trimmedCapabilityUseText"
                },
                {
                  "type": "string",
                  "maxLength": 500
                }
              ]
            }
          },
          "retainedGuarantees": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/trimmedCapabilityUseText"
                },
                {
                  "type": "string",
                  "maxLength": 500
                }
              ]
            }
          },
          "catalogFilters": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/trimmedCapabilityUseText"
                },
                {
                  "type": "string",
                  "maxLength": 200
                }
              ]
            }
          }
        }
      }
    },
    "capabilityDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "useId",
          "disposition",
          "reason"
        ],
        "properties": {
          "useId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "disposition": {
            "type": "string",
            "enum": [
              "direct-adoption",
              "compatibility-layer",
              "keep-business",
              "foundation-gap"
            ]
          },
          "targetCapability": {
            "type": "string",
            "pattern": "^foundation\\.[a-z0-9\\-]+(\\.[a-z0-9\\-]+)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "disposition"
              ],
              "properties": {
                "disposition": {
                  "enum": [
                    "direct-adoption",
                    "compatibility-layer"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "targetCapability"
              ],
              "properties": {
                "targetCapability": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "disposition"
              ],
              "properties": {
                "disposition": {
                  "enum": [
                    "keep-business",
                    "foundation-gap"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "targetCapability"
                ],
                "properties": {
                  "targetCapability": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "单调递增的迁移清单世代号；每当旧设施或豁免集合变更时递增。"
    },
    "legacyInfra": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "replacedBy"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "description": "待退出旧实现的项目相对 POSIX 路径（仅做字面形态约束；绝对路径、目录穿越、UNC/盘符路径与符号链接逃逸在评估期由 Harness 封闭拒绝）。"
          },
          "replacedBy": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "替代该旧实现的机制入口（工具、命令或模块）；空值不构成有效退出声明。"
          },
          "useId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "recoveryRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "replacedBy"
              ],
              "properties": {
                "replacedBy": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "useId"
              ],
              "properties": {
                "useId": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "legacyReferences": {
      "type": "array",
      "description": "保留文件中必须退出的旧文本引用列表：每项声明因其他职责保留的文件路径、禁止继续出现的精确字面文本以及替代机制；机制不删除该文件本身，仅要求旧引用文本彻底清零。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "text",
          "replacedBy"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "description": "保留文件的项目相对 POSIX 路径；目录包含边界在评估期强制执行。"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "文件中不得再出现的精确 UTF-8 字面文本（按字节精确匹配，不作正则解释）。"
          },
          "replacedBy": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "替代该旧引用的新机制标识；不得为空。"
          },
          "useId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "replacedBy"
              ],
              "properties": {
                "replacedBy": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "useId"
              ],
              "properties": {
                "useId": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "reason",
          "deadline",
          "migrationTarget"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": "string",
            "minLength": 1,
            "description": "可解析的到期时间；评估时钟判定过期后绝不自动续期（此处约束字面形态，可解析性在运行期核验）。"
          },
          "migrationTarget": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targetProfile": {
      "type": "string",
      "minLength": 1,
      "description": "目标项目接入的 Profile 标识符；接入收口要求与接入计划中的 Profile 精确一致。"
    },
    "foundationPackages": {
      "type": "array",
      "description": "精确的 Foundation 包绑定列表：每项将已发布包名锁定到精确版本号与 sha256 制品摘要，不接受浮动标签或别名。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "精确语义化版本号（不含范围算符）。"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "description": "格式为 sha256:<64位小写十六进制> 的内容摘要。"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "证明接入已通过验证的四类证据路径（unit、integration、consumer、independent-audit），均为目标项目根目录内的相对 POSIX 路径，由收口门禁按封闭失败原则核验存在性与身份一致性。",
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "integration": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "independentAudit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        }
      }
    }
  },
  "$defs": {
    "trimmedCapabilityUseText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*\\u0000)[\\s\\S]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "capabilityUses"
        ],
        "properties": {
          "capabilityUses": {
            "type": "array"
          }
        }
      },
      "then": {
        "required": [
          "capabilityUseContext"
        ],
        "properties": {
          "capabilityUseContext": {
            "type": "object"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "capabilityUseContext"
              ],
              "properties": {
                "capabilityUseContext": {
                  "type": "object"
                }
              }
            },
            {
              "required": [
                "capabilityDecisions"
              ],
              "properties": {
                "capabilityDecisions": {
                  "type": "array"
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "capabilityDecisions"
        ],
        "properties": {
          "capabilityDecisions": {
            "type": "array"
          }
        }
      },
      "then": {
        "required": [
          "capabilityUses",
          "capabilityUseContext"
        ],
        "properties": {
          "capabilityUses": {
            "type": "array"
          },
          "capabilityUseContext": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "legacyInfra"
        ],
        "properties": {
          "legacyInfra": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "useId"
              ],
              "properties": {
                "useId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "capabilityUses",
          "capabilityUseContext"
        ],
        "properties": {
          "capabilityUses": {
            "type": "array"
          },
          "capabilityUseContext": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "legacyReferences"
        ],
        "properties": {
          "legacyReferences": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "useId"
              ],
              "properties": {
                "useId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "capabilityUses",
          "capabilityUseContext"
        ],
        "properties": {
          "capabilityUses": {
            "type": "array"
          },
          "capabilityUseContext": {
            "type": "object"
          }
        }
      }
    }
  ]
}
