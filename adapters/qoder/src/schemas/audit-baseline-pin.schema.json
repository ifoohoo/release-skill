{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/audit-baseline-pin.json",
  "title": "AuditBaselinePin",
  "description": "审计基线锁契约（GAP-5 / SG-28，FVD-005 谱系）：独立审计用于锁定已批准 Contracts 版本的冻结文档，记录审计表面总摘要、四类核心文档摘要（registry、errorCodes、rules、kernelProtocol）、逐个 Schema 摘要及校验引擎固定事实。基线锁按 Contracts 版本追加写入，由 describeAuditSurface() 机械派生；活动表面偏离基线锁判为 AUD-BASE-001，锁比对失败判为 AUD-LOCK-001（错误码归属审计命名空间）。supersedes 字段记录前序基线锁文件名以保持谱系可追溯。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "provenance",
    "frozenAt",
    "contractsVersion",
    "auditSurfaceVersion",
    "digestAlgorithm",
    "note",
    "surfaceDigest",
    "documentDigests",
    "schemaDigests",
    "facts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.audit-baseline-pin"
    },
    "provenance": {
      "enum": [
        "product-compatibility-fixture",
        "independent-audit"
      ],
      "description": "基线锁的生成来源类别：product-compatibility-fixture 表示产品侧由 describeAuditSurface() 机械派生的兼容性夹具；independent-audit 表示由独立审计消费方生成。"
    },
    "frozenAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "基线锁冻结的日历日期（YYYY-MM-DD）。"
    },
    "contractsVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "本基线锁锁定的 Contracts 版本号。"
    },
    "auditSurfaceVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "派生本基线锁时使用的审计消费表面协议版本。"
    },
    "digestAlgorithm": {
      "const": "sha256",
      "description": "摘要算法；仅允许 sha256。"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "description": "面向人类阅读的来源说明备注。"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^contracts-[0-9]+\\.[0-9]+\\.[0-9]+\\.pin\\.json$",
      "description": "本基线锁所替代的前序基线锁文件名（FVD-005 谱系）；仅谱系首个基线锁可省略。"
    },
    "surfaceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "完整审计表面规范化 JSON 的 SHA-256 十六进制摘要（由 digestAuditSurface 计算）。"
    },
    "documentDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "errorCodes",
        "rules",
        "kernelProtocol"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "errorCodes": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kernelProtocol": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "schemaDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "从各 Schema 的 $id 到该 Schema 文档规范化 JSON SHA-256 十六进制摘要的映射。"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractObjects",
        "checkTypes",
        "mandatoryRuleIds",
        "ruleBudget",
        "errorCodes",
        "kernelOperations",
        "kernelTerminalStates",
        "validationPolicies",
        "supportedDialects",
        "errorCodeStabilityPolicy",
        "schemaIdNamespace"
      ],
      "properties": {
        "contractObjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mandatoryRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ruleBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "firstVersionMax",
            "absoluteMax"
          ],
          "properties": {
            "firstVersionMax": {
              "type": "integer",
              "minimum": 1
            },
            "absoluteMax": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "errorCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SFC[0-9]{4}$"
          }
        },
        "kernelOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kernelTerminalStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validationPolicies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        },
        "supportedDialects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errorCodeStabilityPolicy": {
          "type": "string",
          "minLength": 1
        },
        "schemaIdNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
