{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/watchdog-termination-envelope.json",
  "title": "WatchdogTerminationEnvelope",
  "description": "有界子进程监督产出的终止证据信封（FND-ADR-012）：仅报告进程终止事实，重试与重启策略归上层编排负责，机制绝不自动重启受监督进程；存活判定仅依据退出事件、信号与进程组探测；terminationReason、watchdogReason 与进程状态均采用封闭枚举（未触发看门狗终止时为 null）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ok",
    "exitStatus",
    "processStatus",
    "terminationReason",
    "watchdogReason",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "skill-family.watchdog-termination-envelope"
    },
    "ok": {
      "type": "boolean"
    },
    "exitStatus": {
      "type": "integer",
      "minimum": 0
    },
    "processStatus": {
      "enum": [
        "PLANNED",
        "STARTING",
        "RUNNING",
        "EXITED",
        "FAILED_TO_START",
        "TIMED_OUT",
        "TERMINATED"
      ]
    },
    "terminationReason": {
      "enum": [
        "hard_ceiling",
        "startup_idle",
        "stream_idle",
        "tool_lease_expired",
        "failed_to_start",
        "completed",
        "child_exit",
        "context_budget_exhausted",
        "output_limit_exceeded",
        null
      ]
    },
    "watchdogReason": {
      "enum": [
        "max_seconds",
        "startup_stale_progress",
        "stale_progress",
        "tool_lease_expired",
        "runtime_error",
        "terminal_progress",
        "no_terminal_result",
        "residual_process_group",
        "context_budget_exhausted",
        "output_limit_exceeded",
        null
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args",
        "cwd",
        "startedAt",
        "finishedAt",
        "checkIntervalSeconds",
        "signalSequence",
        "forcedKill",
        "startupProgressPaths",
        "terminalProgressPaths",
        "timeoutPolicy",
        "guarantees"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "checkIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "processGroupId": {
          "type": "integer",
          "minimum": 0
        },
        "childExitCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "childSignal": {
          "type": [
            "string",
            "null"
          ]
        },
        "spawnError": {
          "type": "string"
        },
        "signalSequence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal",
              "requestedMode"
            ],
            "properties": {
              "signal": {
                "type": "string"
              },
              "requestedMode": {
                "enum": [
                  "process_group",
                  "child_process",
                  "job_object"
                ]
              },
              "successfulMode": {
                "enum": [
                  "process_group",
                  "child_process",
                  "job_object"
                ]
              }
            }
          }
        },
        "forcedKill": {
          "type": "boolean"
        },
        "startupProgressPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminalProgressPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxSeconds",
            "killGraceSeconds"
          ],
          "properties": {
            "startupStaleSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "startupIdleSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "streamIdleSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "toolLeaseSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "killGraceSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "terminalIdentity": {
          "type": "string"
        },
        "terminalStatus": {
          "type": "string"
        },
        "residualGroupCleanupCompleted": {
          "type": "boolean"
        },
        "outputByteLimits": {
          "$ref": "#/$defs/outputByteLimits"
        },
        "outputLimitExceeded": {
          "enum": [
            "stdout",
            "stderr",
            null
          ]
        },
        "windowsJob": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "associatedBeforeResume",
            "terminationRequested",
            "activeProcessZeroObserved",
            "handleClosed",
            "cleanupCompleted"
          ],
          "properties": {
            "associatedBeforeResume": {
              "type": "boolean"
            },
            "terminationRequested": {
              "type": "boolean"
            },
            "activeProcessZeroObserved": {
              "type": "boolean"
            },
            "handleClosed": {
              "type": "boolean"
            },
            "cleanupCompleted": {
              "type": "boolean"
            }
          }
        },
        "guarantees": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "closed-enum-evidence",
              "fail-closed",
              "no-auto-restart",
              "no-liveness-guessing",
              "process-group-termination",
              "mechanism-holds-no-timeout-values"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "windowsJob": false,
              "signalSequence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "requestedMode": {
                      "enum": [
                        "process_group",
                        "child_process"
                      ]
                    },
                    "successfulMode": {
                      "enum": [
                        "process_group",
                        "child_process"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "required": [
              "windowsJob"
            ],
            "properties": {
              "processGroupId": false,
              "childSignal": {
                "not": {
                  "enum": [
                    "SIGTERM",
                    "SIGKILL"
                  ]
                }
              },
              "windowsJob": {
                "type": "object"
              },
              "signalSequence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "const": "TerminateJobObject"
                    },
                    "requestedMode": {
                      "const": "job_object"
                    },
                    "successfulMode": {
                      "const": "job_object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "outputByteLimits": {
      "description": "有界子进程监督的可选单流原始字节上限（FND-DES-014 第 6.2 节）：封闭对象至少声明一个输出流，取值为 0 至 Number.MAX_SAFE_INTEGER 的整数；未声明的流不设上限，任一流累计 Buffer 字节数超限时立即锁存事实并进入既有终止路径。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stdout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stderr": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
