{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/operation-request.json",
  "title": "OperationRequest",
  "description": "内核协议操作请求信封：向已注册协议名称与版本发起具名操作及参数；信封外层结构固定，操作词表在内核协议定义中登记。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocol",
    "operationId",
    "operation",
    "params"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.operation-request"
    },
    "protocol": {
      "$ref": "#/$defs/protocolRef"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "调用方选定的操作唯一标识符，由返回结果原样回显。"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "请求执行的操作名称，必须属于所引用协议版本的冻结操作词表。"
    },
    "params": {
      "type": "object",
      "description": "操作专属参数对象；各操作的固定参数契约由内核协议定义约束。"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "可选的请求创建 RFC 3339 时间戳。"
    }
  },
  "$defs": {
    "protocolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)*$",
          "description": "已注册的协议名称（点分 kebab-case 段）。"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "已注册的协议整数版本号。"
        }
      }
    }
  }
}
