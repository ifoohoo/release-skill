{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/platform-difference-registry.json",
  "title": "PlatformDifferenceRegistry",
  "description": "多宿主平台差异注册表（审计 SG-08 / PSG-02）：按 directory、manifest、discovery、invocation、internalIsolation、capabilityGaps、degradationConditions 七个必填维度记录各支持宿主的差异。降级条目仅可表达平台实现差异或未核验状态，绝不得拉低主平台状态，也绝不得放宽共同业务语义。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "primaryPlatforms",
    "requiredDimensions",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.platform-difference-registry"
    },
    "description": {
      "type": "string"
    },
    "primaryPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredDimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "directory",
          "manifest",
          "discovery",
          "invocation",
          "internalIsolation",
          "capabilityGaps",
          "degradationConditions"
        ]
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/platformEntry"
      }
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "除 registryDigest 自身外全部顶层字段规范化 JSON 的 SHA-256 十六进制摘要。"
    },
    "thirdPartyNotes": {
      "type": "string"
    },
    "thirdPartyContract": {
      "type": "string",
      "description": "第三方实例指向本契约所使用的路径或 $id 引用。"
    }
  },
  "$defs": {
    "platformEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platformId",
        "primaryPlatform",
        "directory",
        "manifest",
        "discovery",
        "invocation",
        "internalIsolation",
        "capabilityGaps",
        "degradationConditions"
      ],
      "properties": {
        "platformId": {
          "type": "string",
          "minLength": 1
        },
        "primaryPlatform": {
          "type": "boolean"
        },
        "lowersPrimaryPlatformStatus": {
          "const": false,
          "description": "必须固定为 false：任何平台差异条目均不得拉低主平台状态。"
        },
        "loosensCommonBusinessSemantics": {
          "const": false,
          "description": "必须固定为 false：任何平台差异条目均不得放宽共同业务语义。"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/dimensionFact"
        },
        "discovery": {
          "$ref": "#/$defs/dimensionFact"
        },
        "invocation": {
          "$ref": "#/$defs/dimensionFact"
        },
        "internalIsolation": {
          "$ref": "#/$defs/dimensionFact"
        },
        "capabilityGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "degradationConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dimensionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        }
      }
    }
  }
}
