{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/profile-adoption-declaration.json",
  "title": "ProfileAdoptionDeclaration",
  "description": "Profile 采用与自加严覆盖声明契约（审计整改 D-6 / D-8，SPI v3）：定义提供方描述符与项目 Profile 共用的 adoption（已采用的 Foundation Profile 身份及三包文件级 sha256 绑定）和 overrides（基于既有规则 ID 的项目级数值自加严声明）结构；SPI 层转发至此处定义并对照规则基线目录核验加严方向。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "adoption"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.profile-adoption-declaration"
    },
    "adoption": {
      "$ref": "#/$defs/adoption"
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    },
    "note": {
      "type": "string",
      "description": "可选的人类可读说明备注，不参与机械消费。"
    }
  },
  "$defs": {
    "pinnedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation_profile",
        "foundation_pin",
        "adopted_at"
      ],
      "properties": {
        "foundation_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "stability"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "stability": {
              "enum": [
                "stable",
                "candidate-only"
              ]
            }
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^foundation\\.[a-z0-9\\-]+(?:\\.[a-z0-9\\-]+)+$"
          }
        },
        "foundation_pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "packages"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "packages": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill-family-contracts",
                "skill-family-harness-node",
                "skill-family-engineering-kit"
              ],
              "properties": {
                "skill-family-contracts": {
                  "$ref": "#/$defs/pinnedPackage"
                },
                "skill-family-harness-node": {
                  "$ref": "#/$defs/pinnedPackage"
                },
                "skill-family-engineering-kit": {
                  "$ref": "#/$defs/pinnedPackage"
                }
              }
            }
          }
        },
        "adopted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "parameter",
          "value"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^SFA-[A-Z0-9]+-[0-9]{3}$"
          },
          "parameter": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "value": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
