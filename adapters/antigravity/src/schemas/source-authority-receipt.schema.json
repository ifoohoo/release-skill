{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/source-authority-receipt.json",
  "title": "Source Authority Receipt",
  "description": "业务中立的外部源权威收据：将单一源码仓库与基准提交绑定到按确定性顺序排列的精确包主体集合。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceRepository",
    "sourceBaseCommit",
    "subjects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.source-authority-receipt"
    },
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceBaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageName",
          "version",
          "filename",
          "sha256"
        ],
        "properties": {
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
