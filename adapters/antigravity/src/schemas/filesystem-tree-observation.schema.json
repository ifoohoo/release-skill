{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/filesystem-tree-observation.json",
  "title": "Filesystem tree observation",
  "description": "绑定文件系统目录树的单遍完整事实观测（FND-DES-014 第 6.1 节）。仅供私有核验使用：由公开只读 Harness 入口返回，但绝不进入公开插件核验结果。记录保留原始根绑定以供消费方复核同一根目录，绝不重新绑定替代路径。默认模式与显式 reject 模式保留 0.14 的 UTF-16 码元顺序，record 模式采用 Unicode 码位顺序。目录条目仅携带身份、类型与权限事实；schemaVersion=1（POSIX）下文件字节读取自提供 statMode 的同一原生文件描述符；schemaVersion=2（Windows）下 statMode 为 null、permissionObservation 必填，已记录符号链接携带 reparseTag；v1 不接受 Windows 根绑定基准。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "rootBinding",
    "members",
    "membersDigest"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "skill-family.filesystem-tree-observation"
    },
    "rootBinding": {
      "$ref": "https://contracts.skill-family.example/v1/filesystem-root-binding.json"
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/posixFile"
          },
          {
            "$ref": "#/$defs/posixDirectory"
          },
          {
            "$ref": "#/$defs/posixSymlink"
          },
          {
            "$ref": "#/$defs/windowsFile"
          },
          {
            "$ref": "#/$defs/windowsDirectory"
          },
          {
            "$ref": "#/$defs/windowsSymlink"
          }
        ]
      }
    },
    "membersDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "rootBinding": {
            "type": "object",
            "properties": {
              "basis": {
                "const": "canonical-realpath-device-inode-type-mode-v1"
              }
            }
          },
          "members": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/posixFile"
                },
                {
                  "$ref": "#/$defs/posixDirectory"
                },
                {
                  "$ref": "#/$defs/posixSymlink"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "rootBinding": {
            "type": "object",
            "properties": {
              "basis": {
                "const": "canonical-finalpath-volume-fileid-type-security-v1"
              }
            }
          },
          "members": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/windowsFile"
                },
                {
                  "$ref": "#/$defs/windowsDirectory"
                },
                {
                  "$ref": "#/$defs/windowsSymlink"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "statMode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "permissionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attributes",
        "securityDigest"
      ],
      "properties": {
        "kind": {
          "const": "windows-security-v1"
        },
        "attributes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "securityDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "posixFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "sha256",
        "bytes",
        "statMode",
        "contentBase64"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "file"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "statMode": {
          "$ref": "#/$defs/statMode"
        },
        "contentBase64": {
          "type": "string"
        }
      }
    },
    "posixDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "statMode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "directory"
        },
        "statMode": {
          "$ref": "#/$defs/statMode"
        }
      }
    },
    "posixSymlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "targetBase64",
        "bytes",
        "statMode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "symlink"
        },
        "targetBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "statMode": {
          "$ref": "#/$defs/statMode"
        }
      }
    },
    "windowsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "sha256",
        "bytes",
        "statMode",
        "contentBase64",
        "permissionObservation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "file"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "statMode": {
          "type": "null"
        },
        "contentBase64": {
          "type": "string"
        },
        "permissionObservation": {
          "$ref": "#/$defs/permissionObservation"
        }
      }
    },
    "windowsDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "statMode",
        "permissionObservation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "directory"
        },
        "statMode": {
          "type": "null"
        },
        "permissionObservation": {
          "$ref": "#/$defs/permissionObservation"
        }
      }
    },
    "windowsSymlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "targetBase64",
        "bytes",
        "statMode",
        "reparseTag",
        "permissionObservation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "symlink"
        },
        "targetBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "statMode": {
          "type": "null"
        },
        "reparseTag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "permissionObservation": {
          "$ref": "#/$defs/permissionObservation"
        }
      }
    }
  }
}
