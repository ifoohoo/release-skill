{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/state-snapshot-metadata.json",
  "title": "StateSnapshotMetadata",
  "description": "绑定至已完整核验事件前缀的派生状态快照元数据：损坏快照可直接丢弃重建，事件历史始终为唯一权威真源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "lastSequence",
    "chainHeadDigest",
    "stateDigest",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.state-snapshot-metadata"
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 0
    },
    "chainHeadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {},
    "hostSessionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
