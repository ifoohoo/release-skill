{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/profile-descriptor.json",
  "title": "ProfileDescriptor",
  "description": "Profile 描述符契约：声明单个 Profile 的身份、所扩展的基础 Contracts 版本、相对基础契约的有限差异清单以及提供的稳定 SPI 实现；公共核心不反向依赖具体 Profile。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profile",
    "base"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.profile-descriptor"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "稳定的 kebab-case Profile 标识符。"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractsVersion"
      ],
      "properties": {
        "contractsVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "该 Profile 所扩展的基础 Contracts 版本号。"
        }
      }
    },
    "differences": {
      "type": "array",
      "description": "相对于基础 Contracts 的有限显式差异列表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "adds",
              "overrides",
              "removes"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "差异作用的目标标识（结构名、文件角色或扩展点）。"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "spi": {
      "type": "array",
      "description": "该 Profile 提供的稳定 SPI 入口实现列表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "entrypoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "description": "SPI 入口模块的项目相对 POSIX 路径。"
          }
        }
      }
    }
  }
}
