{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/structured-scan-policy.json",
  "title": "StructuredScanPolicy",
  "description": "结构化表面扫描器的声明式策略契约（FND-ADR-011）：由消费方声明允许的 CIDR 网段、已批准注册表、已批准 npm 坐标、格式解析适配器及符号链接/二进制封闭失败模式，扫描器执行九类封闭违规规则。本契约面向公开参数化结构扫描器，与工作区私有 leak-policy.json 实例文档共享封闭失败原则但字节结构彼此独立。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "allowedNetworks",
    "approvedRegistries",
    "approvedCoordinates",
    "formatAdapters",
    "symlinkPolicy",
    "binaryPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.structured-scan-policy"
    },
    "allowedNetworks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "approvedRegistries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "approvedCoordinates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "formatAdapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "pathPattern"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pathPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "symlinkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "forbid"
        }
      }
    },
    "binaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "approvedPaths"
      ],
      "properties": {
        "mode": {
          "const": "fail-closed"
        },
        "approvedPaths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "hostKeyPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
