{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/professional-conclusion.json",
  "title": "ProfessionalConclusion",
  "description": "Minimal exchange contract for a provider-owned professional conclusion. Foundation fixes the common shape and completion semantics without interpreting the provider's domain code or details.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "provider", "subject", "scope", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "skill-family.professional-conclusion" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "limitations"],
      "properties": {
        "checked": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion", "code", "summary"],
      "properties": {
        "completion": { "enum": ["complete", "partial", "not-performed"] },
        "code": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "details": {
      "type": "object",
      "description": "Provider-owned JSON object. Foundation does not interpret its domain fields."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "type": "object",
            "properties": { "completion": { "const": "complete" } },
            "required": ["completion"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "scope": {
            "type": "object",
            "properties": { "checked": { "type": "array", "minItems": 1 } },
            "required": ["checked"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "type": "object",
            "properties": { "completion": { "const": "partial" } },
            "required": ["completion"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "checked": { "type": "array", "minItems": 1 },
              "limitations": { "type": "array", "minItems": 1 }
            },
            "required": ["checked", "limitations"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "type": "object",
            "properties": { "completion": { "const": "not-performed" } },
            "required": ["completion"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "checked": { "type": "array", "maxItems": 0 },
              "limitations": { "type": "array", "minItems": 1 }
            },
            "required": ["checked", "limitations"]
          }
        }
      }
    }
  ]
}
