{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/observation-scope.json",
  "title": "ObservationScope",
  "description": "观测范围受控词表契约（对齐审计侧插件项目观测 Schema v2）：冻结观测记录允许使用的全部受控词表，包括观测范围、标准平台集合（含 qoder/dsh 扩展）、严重级别、Foundation 接入状态、路径基准、Token 计量对象、缺席平台意图及消费形态，作为跨仓库唯一机械参考。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scopeVocabulary",
    "standardPlatforms",
    "severityLevels",
    "adoptionStatuses",
    "pathBasisVocabulary",
    "measurementSubjects",
    "missingPlatformIntents",
    "consumptionForms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.observation-scope"
    },
    "alignedObservationSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "本词表对齐的观测契约文档版本列表（如 1.0.0-candidate、2.0.0-candidate）。"
    },
    "scopeVocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "skill",
          "plugin",
          "release"
        ]
      }
    },
    "standardPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude-code",
          "codex",
          "kimi-code",
          "workbuddy",
          "qoder",
          "dsh"
        ]
      }
    },
    "severityLevels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "block",
          "error",
          "warning",
          "observe"
        ]
      }
    },
    "adoptionStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "foundation-adopted",
          "self-built",
          "exempted",
          "not-adopted",
          "unknown"
        ]
      }
    },
    "pathBasisVocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "project-root-relative"
        ]
      }
    },
    "measurementSubjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "logical-source",
          "worst-projection"
        ]
      }
    },
    "missingPlatformIntents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported",
          "planned",
          "experimental",
          "deprecated-host"
        ]
      }
    },
    "consumptionForms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dependencies",
          "vendored-bundle",
          "tarball-pin",
          "none",
          "other"
        ]
      }
    },
    "note": {
      "type": "string",
      "description": "可选的人类可读说明备注，不参与机械消费。"
    }
  }
}
