{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/engineering-baseline.json",
  "title": "EngineeringBaseline",
  "description": "业务中立的工程基线身份契约：承载提供方拥有的基线标识、规范规则谱系引用及 Foundation 参考实现身份；不包含规则正文、效力裁决、等价判定或豁免语义。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "provider",
    "id",
    "version",
    "digest",
    "canonicalRuleRefs",
    "referenceImplementation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.engineering-baseline"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "拥有该基线身份的提供方标识（例如独立审计实现）。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "提供方作用域内的稳定基线标识符。"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "提供方基线身份的语义化版本号。"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "剔除 digest 字段后当前文档规范化 JSON 的 SHA-256 摘要。"
    },
    "canonicalRuleRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/canonicalRuleRef"
      },
      "description": "按谱系 ID 升序排列且不重复的提供方规范规则谱系引用；规则正文与裁决留在契约之外。"
    },
    "referenceImplementation": {
      "$ref": "#/$defs/referenceImplementation",
      "description": "基线提供方所对齐的 Foundation 参考实现身份。"
    }
  },
  "$defs": {
    "canonicalRuleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "revisionDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "referenceImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundationVersion",
        "profile",
        "skeletonDigest"
      ],
      "properties": {
        "foundationVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "skeletonDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
